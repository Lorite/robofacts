<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robofacts_ros2</name>
  <version>0.1.0</version>
  <description>The ROS 2 backend of RoboFACTS (Factors, A Contract, and checked Trials in Simulation and on hardware): ros2 launch, ros2 bag record, the bag readers, the ROS 2 gate checks, the robot adapters and the web interface. The general package robofacts holds the declarations, the planner, the trial loop, the gate protocol and the coverage index.</description>
  <maintainer email="a.lorite.mora@gmail.com">Alejandro Lorite Mora</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- The general package of this repository: a plain Python package, built by colcon from the
       folder next to this one (no package.xml there), or installed with pip. -->
  <exec_depend>robofacts</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>demo_nodes_cpp</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
